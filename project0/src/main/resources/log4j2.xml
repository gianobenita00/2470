<?xml version="1.0" encoding="UTF-8"?>

<Configuration status="WARN">

    <Appenders>

        <File name="BankFile" fileName="logs/bank.log">

            <PatternLayout
                pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %msg%n"/>

        </File>

    </Appenders>

    <Loggers>

        <Root level="info">

            <AppenderRef ref="BankFile"/>

        </Root>

    </Loggers>

</Configuration>